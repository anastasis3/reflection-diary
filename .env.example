# Copy this file to .env and adjust the values.
# .env itself is in .gitignore and must never be committed.

# --- server -----------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API from a browser.
# The front-end in /public is served by the same server, so it needs no entry
# here; this matters only when the front-end is hosted separately.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- authentication ---------------------------------------------------------
# Secret used to sign access tokens. Generate your own before any real use:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-this-is-only-a-development-secret
JWT_EXPIRES_IN=7d

# --- storage ----------------------------------------------------------------
# memory   — a JSON file (DATA_FILE). Nothing else to set up. Tests use this.
# supabase — PostgreSQL + Supabase Auth. Fill in the four values below.
DB_DRIVER=memory
DATA_FILE=./data/db.json

# Supabase → Connect (top bar) → Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Settings → API Keys → Secret keys (sb_secret_…). Server only,
# never in the browser. (The legacy service_role key also works here.)
SUPABASE_SECRET_KEY=
# Supabase → Connect → Session pooler → copy the URI, then replace
# [YOUR-PASSWORD] with the database password you chose for the project.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# AES-256 key for entry text, 64 hex characters. Generate once and keep it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing it makes every stored entry unreadable.
ENTRY_ENCRYPTION_KEY=

# --- question selection (see src/services/selection.service.js) --------------
# Three questions a day: two from the weights, one random (the control).
# Probability that the second adaptive question explores a quiet zone
# instead of taking another of the top three.
EXPLORATION_RATE=0.15
# How much picking a question moves its zone up, once per question.
CHOICE_BOOST=0.03
# Learning rate of the weight update: new = ALPHA * score + (1 - ALPHA) * old
ADAPTATION_ALPHA=0.3

# --- classification ---------------------------------------------------------
# keyword  — the offline classifier in src/services/classification.service.js
# failing  — always fails, to exercise the degraded path (screen S-04b)
CLASSIFIER=keyword
